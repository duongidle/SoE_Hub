# SoE Hub environment. Copy to `.env` and fill in. Never commit `.env`.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Public URL of the system (used for signed file URLs of the local storage driver and OpenAPI servers).
PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info
# Set true behind Caddy so the real client IP is used for rate limiting and audit.
TRUST_PROXY=false

# --- Database ---------------------------------------------------------------------------------
# Runtime role used by api and worker (no schema rights; cannot change audit_log).
DATABASE_URL=postgres://soe_app:change-me-dev@localhost:5432/soe_hub
# Schema owner, used only by migrations. In dev, your local superuser is fine.
DATABASE_MIGRATE_URL=postgres://localhost:5432/soe_hub
# Password given to the runtime role when migrations run (must match DATABASE_URL).
APP_DB_PASSWORD=change-me-dev
# Name of the runtime role (default soe_app). Leave it; tests and e2e use their own roles so they never change this one.
# APP_DB_ROLE=soe_app
# Superuser connection used by `pnpm db:setup` to create the database (dev only).
DATABASE_ADMIN_URL=postgres://localhost:5432/postgres
DB_POOL_MAX=10

# --- Rate limit ---------------------------------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW="1 minute"

# --- Accounts and sessions ---------------------------------------------------------------------
# Secret for CSRF tokens, verification-code hashes and encrypting codes in the outbox.
# REQUIRED in production (random, 32+ chars; `openssl rand -hex 32`): the api and worker refuse to start without it.
# Changing it logs everyone out and invalidates pending codes.
AUTH_SECRET=dev-only-auth-secret-change-me-please
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30
# Google login is optional and off by default (Admin also turns it on in Cài đặt hệ thống). Leave empty to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must equal the "Authorized redirect URI" in Google Cloud. Default: PUBLIC_URL + /api/auth/callback/google
GOOGLE_REDIRECT_URI=

# --- Test-only actor (only read when NODE_ENV=test; never in development or production) ------------
DEV_ACTOR_ID=01900000-0000-7000-8000-000000000001

# --- Trash ------------------------------------------------------------------------------------
TRASH_RETENTION_DAYS=7

# --- File storage -------------------------------------------------------------------------------
# local = files on disk (dev). s3 = Cloudflare R2 / MinIO / AWS S3 (production).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.local-storage
# HMAC key for local signed URLs. REQUIRED (random, 32+ chars) in production when STORAGE_DRIVER=local.
STORAGE_SIGNING_SECRET=dev-only-signing-secret-change-me
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO
S3_FORCE_PATH_STYLE=false
FILE_MAX_BYTES=26214400
FILE_USER_QUOTA_BYTES=2147483648
DOWNLOAD_URL_TTL_SECONDS=300
UPLOAD_URL_TTL_SECONDS=600

# --- Web ----------------------------------------------------------------------------------------
# Folder with the built web app; the api serves it when it exists (production image sets this).
# WEB_DIST_DIR=apps/web/dist

# --- Worker -----------------------------------------------------------------------------------
WORKER_OUTBOX_POLL_MS=1000

# --- Production only (docker-compose.yml) -------------------------------------------------------
# In production set: SITE_ADDRESS, POSTGRES_PASSWORD (owner/superuser of the compose Postgres), APP_DB_PASSWORD
# (runtime role), AUTH_SECRET, STORAGE_DRIVER=s3 with the S3_* values, and keep this file out of git (password manager copy).
# docker-compose.yml builds DATABASE_URL, NODE_ENV, TRUST_PROXY and PUBLIC_URL itself.
# SITE_ADDRESS=hub.example.com
# POSTGRES_PASSWORD=
