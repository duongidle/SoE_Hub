meta {
  name: org.tree.transfer
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/admin/trees/{{manager_id}}/transfer
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "to_manager_id": "{{to_manager_id}}"
  }
}

docs {
  Admin chuyển cả một cây (Leader, User, Guest trong cây) sang Manager khác. Lịch sử cây được giữ.
  Quyền: `data:transfer`.
}
