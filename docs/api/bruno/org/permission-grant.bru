meta {
  name: org.permission.grant
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/org/members/{{id}}/permissions
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "permission": "permission",
    "note": "note"
  }
}

docs {
  Cấp một quyền bổ sung trong danh mục cho một người.
  Quyền: `org:permission:grant`.
}
