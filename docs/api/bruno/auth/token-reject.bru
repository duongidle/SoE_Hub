meta {
  name: auth.token.reject
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/v1/admin/tokens/{{id}}/reject
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "note": "note"
  }
}

docs {
  Admin từ chối token cá nhân đang chờ.
  Quyền: `auth:token:approve`.
}
