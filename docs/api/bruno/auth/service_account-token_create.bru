meta {
  name: auth.service_account.token_create
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/api/v1/admin/service-accounts/{{id}}/tokens
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "name": "name",
    "expires_in_days": 365
  }
}

docs {
  Admin tạo token `soe_svc_…` cho tài khoản hệ thống. Token chỉ hiện một lần, dùng được ngay.
  Quyền: `auth:service_account:manage`.
}
