docs {
  Đăng nhập bằng email + mật khẩu. Đặt cookie phiên (httpOnly) và cookie CSRF.
  Công khai (không cần đăng nhập).
}

script:post-response {
  if (res.status === 200) { bru.setVar("csrf", res.body.data.csrf_token); }
