meta {
  name: auth.service_account.create
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/v1/admin/service-accounts
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "name": "name",
    "description": "description",
    "scopes": [
      "scope"
    ],
    "tree_manager_ids": []
  }
}

docs {
  Admin tạo tài khoản hệ thống: tên, scope, giới hạn trong một hoặc vài cây.
  Quyền: `auth:service_account:manage`.
}
