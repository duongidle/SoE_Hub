meta {
  name: auth.password.set
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/auth/password/set
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "new_password": "mat-khau-cua-ban"
  }
}

docs {
  Đặt mật khẩu lần đầu sau khi đăng nhập Google (bắt buộc trước khi dùng hệ thống).
  Quyền: `auth:self`.
}
