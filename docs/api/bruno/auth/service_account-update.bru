meta {
  name: auth.service_account.update
  type: http
  seq: 21
}

patch {
  url: {{baseUrl}}/api/v1/admin/service-accounts/{{id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "version": 1,
    "name": "name",
    "description": "description",
    "scopes": [
      "scope"
    ],
    "tree_manager_ids": [
      "{{tree_manager_id}}"
    ]
  }
}

docs {
  Admin sửa tài khoản hệ thống (mô tả, scope, cây).
  Quyền: `auth:service_account:manage`.
}
