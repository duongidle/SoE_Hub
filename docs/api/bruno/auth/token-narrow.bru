meta {
  name: auth.token.narrow
  type: http
  seq: 27
}

patch {
  url: {{baseUrl}}/api/v1/auth/tokens/{{id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "menus": {
      "datahub": "read"
    }
  }
}

docs {
  Chủ kết nối thu hẹp menu hoặc hạ mức của kết nối mình; có hiệu lực ngay.
  Quyền: `auth:self`.
}
