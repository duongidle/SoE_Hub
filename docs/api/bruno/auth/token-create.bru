meta {
  name: auth.token.create
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/v1/auth/tokens
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "name": "name",
    "menus": {
      "datahub": "read",
      "deal": "write"
    },
    "expires_in_days": 90
  }
}

docs {
  Tạo kết nối bằng token cá nhân (`soe_pat_…`) với menu và mức. Token chỉ hiện một lần và chờ Admin duyệt mới dùng được.
  Quyền: `auth:self`.
}
