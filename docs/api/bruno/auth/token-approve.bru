meta {
  name: auth.token.approve
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/v1/admin/tokens/{{id}}/approve
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "note": "note",
    "menus": {
      "datahub": "read"
    }
  }
}

docs {
  Admin duyệt kết nối (token cá nhân), có thể duyệt ít quyền hơn bằng `menus`.
  Quyền: `auth:token:approve`.
}
