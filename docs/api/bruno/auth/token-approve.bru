meta {
  name: auth.token.approve
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/v1/admin/tokens/{{id}}/approve
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "note": "note"
  }
}

docs {
  Admin duyệt token cá nhân. Scope được cắt theo quyền hiện tại của chủ token.
  Quyền: `auth:token:approve`.
}
