meta {
  name: home.prefs.set
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/v1/me/prefs/{{prefKey}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "value": ["{{dashboardId}}"]
  }
}

docs {
  Ghi một tuỳ chọn của chính mình (`prefKey` = `home.dashboard_tabs`: tối đa 20 dashboard của mình).
  Quyền: `system:whoami`. Không mở cho AI.
}
