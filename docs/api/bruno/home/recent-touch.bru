meta {
  name: home.recent.touch
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/me/recent
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "type": "datahub",
    "id": "{{datahubId}}"
  }
}

docs {
  Ghi một mục vừa mở vào "Mở gần đây" (datahub, form, dashboard, article; tối đa 20). Chỉ ghi mục mình mở được.
  Quyền: `system:whoami`. Không mở cho AI.
}
