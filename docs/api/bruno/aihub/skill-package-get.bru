meta {
  name: skill.package.get
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/aihub/skills/{{postId}}?include_files=true
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

docs {
  Đọc skill: cây file, SKILL.md, lệnh cài; `include_files=true` trả mọi file, `path=` trả một file. Quyền: `aihub:skill:read`.
}
