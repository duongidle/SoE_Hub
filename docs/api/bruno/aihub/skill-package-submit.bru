meta {
  name: skill.package.submit
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/aihub/skills/submit
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "id": "{{postId}}",
    "check_only": true
  }
}

docs {
  Gửi skill chờ duyệt; `check_only: true` chỉ kiểm tra, không lưu. Quyền: `aihub:skill:post`.
}
