meta {
  name: feedback.status.set
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/v1/feedback/{{feedbackId}}/status
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "status": "viewing",
    "version": 1
  }
}

docs {
  Đổi trạng thái góp ý (người xử lý), có `version`.
  Quyền: `feedback:inbox:manage`.
}
