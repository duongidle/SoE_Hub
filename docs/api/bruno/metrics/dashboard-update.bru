}

patch {
  url: {{baseUrl}}/api/v1/dashboards/{{dashboard_id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "version": 1,
    "name": "Doanh thu quý 4"
  }
}

docs {
  Đổi tên dashboard (gửi version đang thấy).
  Quyền: `datahub:datahub:use`; chỉ chủ datahub.
}
