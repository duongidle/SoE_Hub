meta {
  name: metrics.dashboard.filters.save
  type: http
  seq: 37
}

put {
  url: {{baseUrl}}/api/v1/dashboards/{{dashboard_id}}/my-filters
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "filters": {
      "range": "this_quarter",
      "conditions": [{ "field": "Loại deal", "op": "eq", "value": "POD" }]
    }
  }
}

docs {
  Lưu bộ lọc chung thành bản RIÊNG của bạn trên một dashboard (không đổi mặc định của chủ).
  Quyền: `system:whoami`.
}
