meta {
  name: metrics.dashboard.duplicate
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{dashboard_id}}/duplicate
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "name": "Bản thử"
  }
}

docs {
  Nhân bản dashboard cùng mọi biểu đồ. Không gửi name thì đặt "<tên> (bản sao)".
  Quyền: `datahub:datahub:use`; chỉ chủ datahub.
}
