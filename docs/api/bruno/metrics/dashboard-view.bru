meta {
  name: metrics.dashboard.view
  type: http
  seq: 35
}

get {
  url: {{baseUrl}}/api/v1/dashboards/{{dashboard_id}}/view
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

docs {
  Mở dashboard để xem (chủ, người được chia sẻ, hoặc Guest được cấp). Ghi nhật ký mỗi lần mở.
  Quyền: `system:whoami`.
}
