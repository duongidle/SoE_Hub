meta {
  name: metrics.metric.create
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/datahubs/{{datahub_id}}/metrics
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "metric": {
      "name": "Doanh thu theo loại",
      "source": {
        "table": "Deals",
        "joins": [
          {
            "table": "Thanh toán",
            "as": "TT",
            "on": [
              {
                "left": "Mã deal",
                "right": "Mã deal"
              }
            ]
          }
        ]
      },
      "measure": {
        "agg": "sum",
        "field": "TT.Số tiền"
      },
      "filter": {
        "field": "Loại deal",
        "op": "in",
        "value": [
          "POD",
          "DCC"
        ]
      },
      "time": {
        "field": "Ngày chốt",
        "bucket": "month",
        "range": {
          "kind": "last_n_months",
          "n": 12
        }
      },
      "group_by": [
        "Loại deal"
      ],
      "format": "money"
    }
  }
}

docs {
  Lưu một chỉ số (JSON). Chỉ chủ datahub.
  Quyền: `datahub:datahub:use`.
}
