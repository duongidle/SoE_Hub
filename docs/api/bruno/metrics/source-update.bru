meta {
  name: metrics.source.update
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/api/v1/metric-sources/{{source_id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "version": 1,
    "source": {
      "name": "Deal và thanh toán",
      "table": "Deals",
      "joins": [
        {
          "table": "Thanh toán",
          "as": "TT",
          "on": [
            {
              "left": "Mã deal",
              "right": "Mã deal"
            }
          ],
          "collapse": {
            "Số tiền": "sum"
          }
        }
      ]
    }
  }
}

docs {
  Sửa nguồn dữ liệu (gửi lại cả JSON và version).
  Quyền: `datahub:datahub:use`.
}
