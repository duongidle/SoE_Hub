meta {
  name: datahub.view.update
  type: http
  seq: 30
}

patch {
  url: {{baseUrl}}/api/v1/views/{{view_id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "name": "name",
    "position": 0,
    "config": {}
  }
}

docs {
  Sửa view và TỰ LƯU (đổi lọc, sắp xếp, nhóm, ẩn cột, độ rộng, cố định, thứ tự cột, tô màu).
  Quyền: `datahub:datahub:use`.
}
