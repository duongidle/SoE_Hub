meta {
  name: datahub.import.preview
  type: http
  seq: 62
}

post {
  url: {{baseUrl}}/api/v1/datahub/imports/{{job_id}}/preview
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "mapping": {
      "datahub": { "name": "Lead tháng 12" },
      "import_formulas": false,
      "sheets": [
        {
          "sheet": "du-lieu",
          "header_row": 1,
          "table": { "mode": "new", "name": "Lead" },
          "write": "add",
          "on_error": "skip_row"
        }
      ]
    }
  }
}

docs {
  Bước 5: báo cáo trước khi chạy: số dòng hợp lệ, dòng lỗi và lý do, cột công thức dịch được hay không, vượt giới hạn nào.
  Quyền: `datahub:datahub:use`.
}
