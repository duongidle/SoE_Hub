meta {
  name: datahub.export.create
  type: http
  seq: 59
}

post {
  url: {{baseUrl}}/api/v1/datahub/exports
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "table_id": "{{table_id}}",
    "format": "xlsx",
    "filter": { "field": "Doanh thu", "op": "gt", "value": 0 },
    "sort": "Doanh thu:desc",
    "columns": ["Tên", "Doanh thu"],
    "user_emails": true
  }
}

docs {
  Xuất bảng (hoặc cả datahub) ra CSV, XLSX hoặc JSON. Chạy nền: gọi `datahub.job.get` đến khi xong rồi lấy `datahub.job.download_url`.
  `user_emails: true` thêm cột email ngay sau mỗi cột người (Người dùng, Người tạo, Người sửa); Guest và xuất tổng hợp không dùng được.
  Quyền: `datahub:datahub:use`.
}
