meta {
  name: datahub.merge.update
  type: http
  seq: 65
}

put {
  url: {{baseUrl}}/api/v1/tables/{{table_id}}/merge
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "sources": ["{{source_table_1}}", "{{source_table_2}}"],
    "columns": [
      { "name": "MST", "from": { "{{source_table_1}}": "MST", "{{source_table_2}}": "Mã số thuế" } },
      { "name": "Doanh thu", "from": { "{{source_table_1}}": "Doanh thu", "{{source_table_2}}": "Doanh thu" } }
    ],
    "dedup": { "columns": ["MST"], "strategy": "priority" }
  }
}

docs {
  Đổi cấu hình bảng gộp (nguồn, thứ tự ưu tiên, ghép cột, khoá chống trùng). Chỉ chủ. Dòng được chép lại sau đó.
  Quyền: `datahub:datahub:use`.
}
