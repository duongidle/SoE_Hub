}

patch {
  url: {{baseUrl}}/api/v1/datahubs/{{datahub_id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "name": "name",
    "description": "description",
    "version": 1
  }
}

docs {
  Đổi tên hoặc mô tả datahub (chỉ chủ).
  Quyền: `datahub:datahub:use`.
}
