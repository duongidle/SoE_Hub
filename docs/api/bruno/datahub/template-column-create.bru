meta {
  name: datahub.template.column.create
  type: http
  seq: 86
}

post {
  url: {{baseUrl}}/api/v1/datahub/templates/{{template_id}}/columns
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Idempotency-Key: {{$guid}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Khách hàng",
    "type": "text",
    "layer": "basic",
    "storage": "shared",
    "allow_edit": true
  }
}

docs {
  Thêm cột vào template, có thể kèm `role`. Quyền: `datahub:template:write`.

  Cột Người dùng có thuộc tính (Module 4 mục 4.5): `"type": "user", "config": {"attrs": [{"key": "vai_tro", "label": "Vai trò", "kind": "select", "options": ["Leading", "Associate", "Advisor"]}, {"key": "ty_le_dt", "label": "% doanh thu", "kind": "percent", "default": 0, "sum_max": 1}]}`.
  Cột hệ thống tự điền từ thuộc tính ("gửi xuống"): `"storage": "person", "type": "text", "autofill": {"column": "Người tham gia", "attr": "vai_tro"}`; thêm `"sum": "team"` hoặc `"tree"` để Leader/Manager nhận tổng.
}
