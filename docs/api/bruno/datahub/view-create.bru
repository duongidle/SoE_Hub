meta {
  name: datahub.view.create
  type: http
  seq: 29
}

post {
  url: {{baseUrl}}/api/v1/tables/{{table_id}}/views
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "name": "name",
    "shared": false,
    "config": {}
  }
}

docs {
  Tạo view. View chung chỉ chủ bảng tạo; ai cũng tạo được view cá nhân.
  Quyền: `datahub:datahub:use`.
}
