meta {
  name: datahub.column.update
  type: http
  seq: 14
}

patch {
  url: {{baseUrl}}/api/v1/tables/{{table_id}}/columns/{{column}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "name": "name",
    "config": {},
    "required": false,
    "allow_edit": true,
    "unique": false,
    "default_value": null,
    "description": "description",
    "display": {},
    "position": 0,
    "version": 1,
    "update_formulas": false,
    "notify_on_change": { "people_column": "Người điền" }
  }
}

docs {
  Sửa cột: tên, mô tả, bắt buộc, duy nhất, mặc định, cấu hình (lựa chọn), định dạng hiển thị, vị trí. Không đổi kiểu ở đây.
  `update_formulas: true` (khi đổi tên lựa chọn): viết lại cả các công thức đang so chữ với tên cũ (xem `datahub.column.option_impact`).
  `notify_on_change` (chỉ chủ bảng): khi cột này được sửa bởi người, API hay form, báo cho người ở cột Người dùng `people_column` của dòng đó (không báo khi công thức tính lại; gom theo dòng trong 10 phút). `null` = tắt.
  Quyền: `datahub:datahub:use`.
}
