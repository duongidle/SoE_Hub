meta {
  name: datahub.people.lookup
  type: http
  seq: 45
}

get {
  url: {{baseUrl}}/api/v1/datahub/people
  body: none
  auth: none
}

params:query {
  ~ids: ids
  ~q: q
  ~team_id: team_id
  ~table_id: table_id
  ~limit: 20
}

headers {
  Authorization: Bearer {{token}}
}

docs {
  Tìm người để chọn vào cột Người dùng, hoặc đổi mã người thành tên: theo `ids`, theo `q` (tên hoặc email) hoặc theo `team_id` (cả team).
  Quyền: `datahub:datahub:use`.
}
