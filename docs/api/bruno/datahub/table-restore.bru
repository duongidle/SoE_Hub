meta {
  name: datahub.table.restore
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/tables/{{table_id}}/restore
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "name": "name"
  }
}

docs {
  Khôi phục bảng từ thùng rác (datahub phải còn). Tên đã bị dùng thì gửi `name` mới.
  Quyền: `datahub:datahub:use`.
}
