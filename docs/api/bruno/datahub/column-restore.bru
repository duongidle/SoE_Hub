meta {
  name: datahub.column.restore
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/v1/tables/{{table_id}}/columns/{{column}}/restore
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "name": "name"
  }
}

docs {
  Khôi phục cột từ thùng rác. Tên đã bị dùng thì gửi `name` mới.
  Quyền: `datahub:datahub:use`.
}
