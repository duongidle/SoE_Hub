meta {
  name: datahub.datahub.restore
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/datahubs/{{datahub_id}}/restore
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "name": "name"
  }
}

docs {
  Khôi phục datahub từ thùng rác. Tên đã bị dùng thì gửi `name` mới.
  Quyền: `datahub:datahub:use`.
}
