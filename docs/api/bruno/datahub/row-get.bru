meta {
  name: datahub.row.get
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/api/v1/tables/{{table_id}}/rows/{{row_id}}
  body: none
  auth: none
}

params:query {
  ~fields: fields
  ~labels: false
  ~consistent_after: 0
  ~consistent: false
}

headers {
  Authorization: Bearer {{token}}
}

docs {
  Một dòng.
  Hỗ trợ `consistent_after` / `consistent` như `datahub.row.list`; kết quả có `consistency` và `pending`.
  Quyền: `datahub:datahub:use`.
}
