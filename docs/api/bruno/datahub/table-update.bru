meta {
  name: datahub.table.update
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/v1/tables/{{table_id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "name": "name",
    "description": "description",
    "position": 0,
    "version": 1
  }
}

docs {
  Đổi tên, mô tả hoặc vị trí bảng (chỉ chủ).
  Quyền: `datahub:datahub:use`.
}
