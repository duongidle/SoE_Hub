meta {
  name: notification.mark_read
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/notifications/read
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "ids": [
      "{{id}}"
    ],
    "all": false
  }
}

docs {
  Đánh dấu đã đọc: một số thông báo (`ids`) hoặc tất cả (`all: true`).
  Quyền: `notification:read`.
}
