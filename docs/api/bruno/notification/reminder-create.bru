meta {
  name: reminder.create
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/reminders
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "content": "Gọi lại Thuận Phát",
    "due_at": "2026-11-23T14:00",
    "repeat": "weekly",
    "weekdays": [4]
  }
}

docs {
  Đặt nhắc hẹn cho mình (giờ Việt Nam, lặp tuỳ chọn).
  Quyền: `notification:manage`.
}
