meta {
  name: reminder.update
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/v1/reminders/{{id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "content": "Gọi lại Thuận Phát lúc 15:00",
    "due_at": "2026-11-23T15:00"
  }
}

docs {
  Sửa nhắc hẹn của mình.
  Quyền: `notification:manage`.
}
