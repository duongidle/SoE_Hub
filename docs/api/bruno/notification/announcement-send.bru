meta {
  name: announcement.send
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/v1/announcements
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "title": "Họp team 9h mai",
    "body": "Nội dung thông báo",
    "important": false,
    "scope": { "teams": ["{{leaderId}}"], "user_ids": [] }
  }
}

docs {
  Gửi thông báo chung. Admin: mọi người hoặc cây/team bất kỳ; Manager: cây mình hoặc team trong cây; Leader: team mình; người lẻ nằm trong phạm vi.
  Quyền: `notification:announce`. Qua AI bị cấm.
}
