meta {
  name: file.upload.complete
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/files/{{fileId}}/complete
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

script:post-response {
  if (res.status === 200) { bru.setVar("fileVersion", res.body.data.version); }
}

docs {
  Xác nhận file đã tải lên (kiểm tra dung lượng).
}
