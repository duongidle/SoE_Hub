meta {
  name: form.form.save_draft
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/api/v1/forms/{{formId}}/draft
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "config": {
      "schema": "soe-form/1",
      "title": "Khảo sát",
      "description": "",
      "appearance": {},
      "blocks": [
        {
          "id": "q1",
          "type": "question",
          "input": "text",
          "label": "Công ty của bạn",
          "required": true
        }
      ]
    }
  }
}

docs {
  Lưu bản nháp của form (cấu hình `soe-form/1`). Trình soạn gọi sau mỗi thay đổi; người điền không thấy cho tới khi xuất bản.
  Quyền: `form:form:create`.
}
