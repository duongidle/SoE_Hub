meta {
  name: form.question.link
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/v1/forms/{{formId}}/questions/{{questionId}}/link
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "create": true
  }
}

docs {
  Nối một câu hỏi với một cột của bảng đích: chọn cột (`column_id`) hoặc tạo cột mới (`create: true`, tên lấy theo câu hỏi, chép lựa chọn sang cột).
  Quyền: `form:form:create`.
}
