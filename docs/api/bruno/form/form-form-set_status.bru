meta {
  name: form.form.set_status
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/v1/forms/{{formId}}/status
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "status": "paused"
  }
}

docs {
  Đổi trạng thái: `open` (Đang nhận), `paused` (Tạm dừng), `closed` (Đã đóng). Form chưa xuất bản chưa mở được.
  Quyền: `form:form:create`.
}
